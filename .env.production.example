ENVIRONMENT=production

# Public domains
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# PostgreSQL
POSTGRES_USER=nexa_prod
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=nexa_ai

# Backend database connection
DATABASE_URL=postgresql+psycopg://nexa_prod:replace_with_strong_password@postgres:5432/nexa_ai

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Authentication
JWT_SECRET=replace_with_long_random_secret

# Next.js server-side backend URL
NEXA_API_URL=http://api:8000

# AI inference
OLLAMA_BASE_URL=http://private-ollama-host:11434
OLLAMA_MODEL=your-production-model

# Frontend
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
