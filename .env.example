# Application
ENVIRONMENT=development
APP_ENV=development
APP_NAME=NEXORA API

# PostgreSQL
POSTGRES_USER=nexa
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=nexa_ai

# Backend
DATABASE_URL=postgresql+psycopg://nexa:replace_with_local_password@localhost:5435/nexa_ai
TEST_DATABASE_URL=postgresql+psycopg://nexa:replace_with_local_password@localhost:5435/nexa_ai_test
# Workflow checkpoints use DATABASE_URL when this is unset.
# Tables are created in the langgraph schema of that same database.
# CHECKPOINT_DATABASE_URL=
# Host port 6380 is NEXORA Redis. Port 6379 may belong to another local project.
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15

# AI
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_DEFAULT_MODEL=your-installed-model
LLM_TIMEOUT_SECONDS=300

# Frontend server-side API URL
NEXA_API_URL=http://localhost:8000

# Frontend client-side API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:3000

# Staging and production.
# Copy the names below into an untracked env file such as .env.production.
# Do not put real secrets in this example. Generate a new JWT_SECRET of at
# least 32 characters. Do not copy JWT_SECRET from apps/api/.env.
# Compose reads POSTGRES_* and builds the in-network DATABASE_URL itself.
# Use a URL-safe password made of letters and digits.
# ENVIRONMENT=production
# APP_ENV=production
# POSTGRES_USER=replace_with_staging_user
# POSTGRES_PASSWORD=replace_with_url_safe_password
# POSTGRES_DB=nexa_ai_staging
# DATABASE_URL=postgresql+psycopg://replace_with_staging_user:replace_with_url_safe_password@postgres:5432/nexa_ai_staging
# REDIS_URL=redis://redis:6379/0
# JWT_SECRET=replace_with_at_least_32_characters
# FRONTEND_URL=https://app.example.com
# NEXA_API_URL=http://api:8000
# NEXT_PUBLIC_API_URL=https://api.example.com
# The VPS must be able to open LLM_BASE_URL. host.docker.internal, localhost,
# and 127.0.0.1 are addresses on the developer machine and will not work there.
# LLM_BASE_URL=https://inference.example.com/v1
# LLM_API_KEY=replace_with_inference_key
# APP_DOMAIN=app.example.com
# API_DOMAIN=api.example.com
# LETSENCRYPT_EMAIL=ops@example.com
# Compose sets TRUSTED_HOSTS from API_DOMAIN and always allows the internal
# names localhost, 127.0.0.1, and api. Do not use a wildcard.
# TRUSTED_HOSTS=api.example.com
# COOKIE_SECURE=true
# TRUST_PROXY is true in compose.prod.yaml because Caddy is the only public hop.
# Leave TRUST_PROXY unset here. The local HTTP check sets it to false.
#
# SMTP is blocked until a real mail server is available.
# A placeholder such as smtp.invalid does not send mail. It can only satisfy
# the non-empty production boot check during a local production-mode test.
# Production boot refuses to start while SMTP_HOST or SMTP_FROM_EMAIL is empty.
# Password-reset links use FRONTEND_URL. Leave SMTP_PASSWORD out of logs.
# Use STARTTLS on port 587, or implicit TLS on port 465. Do not enable both.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=NEXORA
# SMTP_USE_STARTTLS=true
# SMTP_USE_SSL=false
#
# Stripe stays blocked until test-mode keys and price ids exist.
# Staging accepts an sk_test_ secret only. An sk_live_ secret is not a staging value.
# The webhook secret must start with whsec_. Price ids must look like price_...
# and must not be placeholders. Billing changes come from signed webhooks.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_STARTER_YEARLY_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_PRO_YEARLY_PRICE_ID=
