# Application
ENVIRONMENT=development
APP_NAME=Nexa AI API

# PostgreSQL
POSTGRES_USER=nexa
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=nexa_ai

# Backend
DATABASE_URL=postgresql+psycopg://nexa:replace_with_local_password@localhost:5435/nexa_ai
TEST_DATABASE_URL=postgresql+psycopg://nexa:replace_with_local_password@localhost:5435/nexa_ai_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15

# AI
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_DEFAULT_MODEL=your-installed-model
LLM_TIMEOUT_SECONDS=300

# Frontend server-side API URL
NEXA_API_URL=http://localhost:8000

# Frontend client-side API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:3000
